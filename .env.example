# GemmaSWE Environment Configuration

# Provider: 'google' | 'groq' | 'openrouter' | 'ollama' | 'mock'
GEMMA_PROVIDER=google

# 1. Google AI Studio (Free tier available for Gemma 2)
# Supported models: gemma-2-27b-it, gemma-2-9b-it
GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemma-2-27b-it

# 2. Groq (High-speed cloud inference)
# Supported models: gemma2-9b-it
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (Cloud access to Gemma 2 models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Ollama (Local quantized model on http://localhost:11434)
# Model: gemma2:9b or gemma2:27b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma2:9b

# Agent Settings
MAX_ITERATIONS=15
AUTO_ROLLBACK_ON_REGRESSION=true
MAX_TEST_RETRIES=4
